{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SignPdf GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/SignPdf.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUNBUFFERED": "1",
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python3"
        },
        {
            "name": "SignPdf CLI with PDF argument",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/SignPdf.py",
            "args": [
                "/home/mariusz/Dokumenty/tmp/w_pass.pdf",
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUNBUFFERED": "1",
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python3"
        },
